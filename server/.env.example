# ============================================================
# Íris — backend OPCIONAL. Copie para .env (NUNCA commitar .env).
# Sem nada disto o app continua 100% funcional no modo local:
# a interface mostra "IA externa não configurada".
# ============================================================

# --- Acesso (obrigatório para qualquer rota além de /health) ---
# Senha compartilhada do casal. Sem ela, as rotas protegidas respondem 503.
IRIS_PASSCODE=
# Segredo para assinar tokens (use um valor longo e aleatório: openssl rand -hex 32)
IRIS_TOKEN_SECRET=
# Origens permitidas por CORS, separadas por vírgula. Vazio = só mesma origem.
ALLOWED_ORIGINS=

# --- LLM (inteligência conversacional) ---
# anthropic | openai | mock   (mock = respostas fixas para teste, sem custo)
IRIS_LLM_PROVIDER=
ANTHROPIC_API_KEY=
IRIS_LLM_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY serve para qualquer API compatível com o formato OpenAI (mude a base abaixo)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Voz premium (opcional) ---
# openai | mock
IRIS_STT_PROVIDER=
IRIS_STT_MODEL=whisper-1
IRIS_TTS_PROVIDER=
IRIS_TTS_MODEL=tts-1
IRIS_TTS_VOICE=nova

# --- Servidor local ---
PORT=8080
