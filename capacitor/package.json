{
  "name": "nosso-sim-capacitor",
  "version": "3.1.0",
  "private": true,
  "description": "Empacotamento Android (Capacitor) do Nosso Sim. Só o site público entra no APK; nenhum dado pessoal.",
  "engines": { "node": ">=22" },
  "scripts": {
    "web": "node ../scripts/build-packages.mjs www --frontend-only",
    "add": "cap add android && node scripts/patch-android.mjs",
    "sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
